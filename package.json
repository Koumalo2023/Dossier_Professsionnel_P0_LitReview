{
  "name": "litreview",
  "version": "1.0.0",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "npm-run-all --parallel dev:server dev:api",
    "dev:server": "ts-node src/index.ts",
    "dev:api": "json-server --watch db.json --port 3001",
    "build": "tsc",
    "sass": "sass src/scss/main.scss dist/css/main.css"
  },
  "dependencies": {
    "express": "^4.18.2"
  },
  "devDependencies": {
    "json-server": "^0.17.3",
    "sass": "^1.75.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.3",
    "npm-run-all": "^4.1.5"
  }
}